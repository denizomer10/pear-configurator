#!/usr/bin/env sh
# PEAR Configurator launcher.
# Runs the release binary if present, otherwise falls back to `cargo run`.
set -e

DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ -x "$DIR/target/release/pear-configurator" ]; then
  exec "$DIR/target/release/pear-configurator" "$@"
fi

cd "$DIR"
exec cargo run --release -- "$@"
