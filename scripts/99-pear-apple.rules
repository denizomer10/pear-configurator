# PEAR Configurator: allow access to Apple devices (including DFU / recovery mode).
#
# Grants the `plugdev` group write access to Apple devices so that libusb
# (and therefore irecovery / idevicerestore) can talk to devices in DFU mode.
#
# Install:
#   sudo install -m 644 scripts/99-pear-apple.rules /etc/udev/rules.d/99-pear-apple.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", MODE="0660", GROUP="plugdev"
