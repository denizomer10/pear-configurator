# PE Configurator: Apple cihazlarina (DFU / kurtarma modu dahil) erisim.
#
# libusb ile DFU/kurtarma modundaki Apple cihazlarina yazma izni verir.
# Kurulum:
#   sudo install -m 644 scripts/99-pear-apple.rules /etc/udev/rules.d/99-pear-apple.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", MODE="0660", GROUP="plugdev"
