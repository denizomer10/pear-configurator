# PEAR Configurator: allow access to Apple devices (including DFU / recovery mode).
#
# This rule is installed automatically by the app on first launch (it asks for
# administrator permission once). It works on Arch, Debian, Fedora and other
# systemd-based distributions: TAG+="uaccess" grants the active local user
# access to the device without requiring a distribution-specific group such as
# "plugdev".
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", TAG+="uaccess"
