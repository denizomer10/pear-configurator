import { ComboBox, ScrollView } from "std-widgets.slint";

// Small status pill (tool / info badges).
component Pill inherits Rectangle {
    in property <string> label;
    in property <color> dot-color: #849593;

    height: 26px;
    border-radius: 13px;
    background: #18332b;
    border-width: 1px;
    border-color: #334842;

    HorizontalLayout {
        alignment: center;
        padding-left: 11px;
        padding-right: 11px;
        spacing: 7px;

        Rectangle {
            width: 8px;
            height: 26px;
            background: transparent;
            Rectangle {
                y: 9px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot-color;
            }
        }
        Text {
            text: root.label;
            color: #a8b9b5;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// Large action button (title + subtitle).
component ActionButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <brush> base-color: #253833;
    in property <bool> active: true;
    callback clicked();

    height: 62px;
    border-radius: 14px;
    background: root.active ? (touch.has-hover ? #34584a : root.base-color) : #ffffff0a;
    border-width: 1px;
    border-color: #ffffff14;
    opacity: root.active ? 1.0 : 0.4;
    animate opacity { duration: 150ms; }

    HorizontalLayout {
        alignment: center;
        padding: 14px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: root.subtitle;
                color: #ffffffb0;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { if (root.active) { root.clicked(); } }
    }
}

export component AppWindow inherits Window {
    title: "PEAR Configurator";
    preferred-width: 1140px;
    preferred-height: 840px;
    min-width: 980px;
    min-height: 780px;
    background: #0d1513;
    default-font-size: 13px;
    // Device
    in-out property <bool> device-connected: false;
    in-out property <string> device-name: "Waiting for device…";
    in-out property <string> mode-label: "—";
    in-out property <color> mode-color: #6d8bff;
    in-out property <[string]> specs: [];

    // Tools
    in-out property <string> tools-summary: "";
    in-out property <bool> tools-ready: false;

    // Firmware
    in property <[string]> firmware-model: [];
    in-out property <int> firmware-index: 0;

    // Progress
    in-out property <float> progress: 0.0;
    in-out property <string> progress-pct: "0%";
    in-out property <string> progress-label: "Ready";
    in-out property <string> progress-detail: "";
    in-out property <bool> job-running: false;

    // Log (newest first)
    in property <[string]> log-lines: [];

    in-out property <bool> can-restore: false;
    in-out property <bool> confirm-visible: false;

    // First-run setup (udev rule)
    in-out property <bool> setup-visible: false;
    in-out property <string> setup-title: "USB access permission";
    in-out property <string> setup-message: "";
    in-out property <string> setup-status: "";
    in-out property <bool> setup-busy: false;
    in-out property <bool> setup-done: false;
    in-out property <bool> setup-error: false;

    callback erase-clicked();
    callback update-clicked();
    callback cancel-clicked();
    callback clear-log();
    callback confirm-accept();
    callback confirm-cancel();
    callback firmware-selected(int);
    callback setup-install();
    callback setup-quit();


    HorizontalLayout {
        padding: 24px;
        spacing: 24px;
        Rectangle {
            width: 244px;
            border-radius: 20px;
            background: #15201c;
            border-width: 1px;
            border-color: #293b33;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "◒  PEAR"; color: #d7f9a5; font-size: 27px; font-weight: 800; }
                Text { text: "CONFIGURATOR"; color: #8fa49a; font-size: 10px; letter-spacing: 2px; }
                Rectangle { height: 1px; background: #293b33; }
                Pill { label: root.device-connected ? "Device connected" : "Waiting for device"; dot-color: root.device-connected ? #d7f9a5 : #8fa49a; }
                Text { text: "01 / CONNECT"; color: #d7f9a5; font-size: 11px; font-weight: 600; }
                Rectangle {
                    height: 104px;
                    border-radius: 14px;
                    background: #203229;
                    Rectangle { x: (parent.width - 64px) / 2; y: 22px; width: 64px; height: 43px; border-radius: 6px; border-width: 2px; border-color: #d7f9a5; }
                    Rectangle { x: (parent.width - 24px) / 2; y: 72px; width: 24px; height: 4px; border-radius: 2px; background: #d7f9a5; }
                }
                Text { text: root.device-connected ? root.device-name : "Connect your device"; color: #f0f5ed; font-size: 20px; font-weight: 600; wrap: word-wrap; }
                Pill { label: root.device-connected ? root.mode-label : "USB connection required"; dot-color: root.mode-color; }
                for spec in root.specs: Text { text: spec; color: #9eb2a6; font-size: 11px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Before you begin"; color: #edf3e9; font-size: 13px; font-weight: 600; }
                Text { text: "Use a reliable USB cable. Keep the device connected throughout the restore."; color: #8fa49a; font-size: 12px; wrap: word-wrap; }
                Rectangle { height: 1px; background: #293b33; }
                Text { text: root.tools-ready ? "●  Restore tools available" : "●  Restore tools missing"; color: root.tools-ready ? #d7f9a5 : #ffad93; font-size: 11px; }
            }
        }
        VerticalLayout {
            spacing: 18px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "DEVICE RECOVERY"; color: #9bae9e; font-size: 10px; letter-spacing: 2px; }
                    Text { text: "A fresh start."; color: #f0f5ed; font-size: 34px; font-weight: 700; }
                    Text { text: "Restore your Apple device, one step at a time."; color: #91a598; font-size: 13px; }
                }
                Rectangle { horizontal-stretch: 1; }
                Pill { width: 180px; label: root.job-running ? "In progress" : "Restore workspace"; dot-color: #d7f9a5; }
            }
            Rectangle {
                height: 280px;
                border-radius: 20px;
                background: #18231e;
                border-width: 1px;
                border-color: #304035;
                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    Text { text: "02 / CHOOSE FIRMWARE"; color: #d7f9a5; font-size: 11px; font-weight: 600; }
                    Text { text: "Choose your next version"; color: #edf3e9; font-size: 21px; font-weight: 600; }
                    ComboBox {
                        enabled: !root.job-running && !root.confirm-visible;
                        model: root.firmware-model;
                        current-index <=> root.firmware-index;
                        selected(value) => { root.firmware-selected(root.firmware-index); }
                    }
                    Text { text: root.device-connected ? "Select firmware, then choose how to restore your device." : "Connect a device in DFU or recovery mode to load firmware."; color: #91a598; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px;
                        ActionButton { horizontal-stretch: 1; title: "Keep Data"; subtitle: "Attempt update / revive"; base-color: #345344; active: root.can-restore; clicked => { root.update-clicked(); } }
                        ActionButton { horizontal-stretch: 1; title: "Erase & Install"; subtitle: "Permanently removes all data"; base-color: #794d3d; active: root.can-restore; clicked => { root.erase-clicked(); } }
                    }
                }
            }
            Rectangle {
                height: 150px;
                border-radius: 20px;
                background: #d7f9a5;
                VerticalLayout {
                    padding: 22px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: "03 / RESTORE STATUS"; color: #36512b; font-size: 11px; font-weight: 600; horizontal-stretch: 1; }
                        Text { text: root.progress-pct; color: #18281a; font-size: 22px; font-weight: 700; }
                    }
                    Text { text: root.progress-label; color: #18281a; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                    Rectangle { height: 6px; background: #b4d28a; border-radius: 3px; clip: true;
                        Rectangle { width: parent.width * root.progress; height: parent.height; background: #36512b; border-radius: 3px; animate width { duration: 200ms; } }
                    }
                    HorizontalLayout {
                        Text { text: root.progress-detail; color: #36512b; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                        if root.job-running: Rectangle { width: 82px; height: 22px; border-radius: 6px; background: #36512b;
                            Text { text: "Cancel"; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.cancel-clicked(); } }
                        }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 16px;
                background: #111b16;
                border-width: 1px;
                border-color: #293b33;
                clip: true;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text { text: "Activity"; color: #c5d3c7; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
                        Rectangle { width: 64px; height: 24px; border-radius: 6px; background: #203229;
                            Text { text: "Clear"; color: #a7baab; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.clear-log(); } }
                        }
                    }
                    if root.log-lines.length == 0: Text { text: "Your download and restore activity will appear here."; color: #7d9584; font-size: 12px; wrap: word-wrap; }
                    ScrollView { VerticalLayout { alignment: start; spacing: 6px;
                        for line in root.log-lines: Text { text: line; color: #a7baab; font-size: 11px; font-family: "monospace"; wrap: word-wrap; }
                    } }
                }
            }
        }
    }
    // ---- First-run setup dialog (udev rule) ----
    if root.setup-visible: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060ce8;
        TouchArea {}

        Rectangle {
            width: 520px;
            height: 300px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: #18231e;
            border-width: 1px;
            border-color: #3c5142;

            VerticalLayout {
                padding: 26px;
                spacing: 14px;

                Text {
                    text: root.setup-title;
                    color: #edf3e9;
                    font-size: 19px;
                    font-weight: 700;
                }
                Text {
                    text: root.setup-message;
                    color: #a8b9a9;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                Text {
                    text: root.setup-status;
                    color: root.setup-error ? #ff8a9a : (root.setup-done ? #35d49a : #b7c0e0);
                    font-size: 13px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    ActionButton {
                        width: 120px;
                        height: 44px;
                        title: "Quit";
                        subtitle: "";
                        base-color: #ffffff12;
                        active: !root.setup-busy;
                        clicked => { root.setup-quit(); }
                    }
                    ActionButton {
                        width: 170px;
                        height: 44px;
                        title: root.setup-busy ? "Installing…" : (root.setup-done ? "Installed" : "Install");
                        subtitle: "";
                        base-color: #345344;
                        active: !root.setup-busy && !root.setup-done;
                        clicked => { root.setup-install(); }
                    }
                }
            }
        }
    }

    // ---- Confirmation dialog ----
    if root.confirm-visible: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #04060cc0;
        TouchArea {}

        Rectangle {
            width: 460px;
            height: 220px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: #18231e;
            border-width: 1px;
            border-color: #3c5142;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: "Erase & Install"; color: #edf3e9; font-size: 19px; font-weight: 700; }
                Text {
                    text: "All data on the device will be permanently erased and the selected version will be installed from scratch. This cannot be undone.";
                    color: #a8b9a9;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    ActionButton {
                        width: 130px;
                        height: 44px;
                        title: "Cancel";
                        subtitle: "";
                        base-color: #ffffff12;
                        clicked => { root.confirm-cancel(); }
                    }
                    ActionButton {
                        width: 150px;
                        height: 44px;
                        title: "Erase & Install";
                        subtitle: "";
                        base-color: @linear-gradient(135deg, #ff4d6d, #ff8a5c);
                        clicked => { root.confirm-accept(); }
                    }
                }
            }
        }
    }
}
